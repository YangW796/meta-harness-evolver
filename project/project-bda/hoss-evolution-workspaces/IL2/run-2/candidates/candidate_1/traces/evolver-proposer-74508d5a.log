dy selected indices\\n 39|     already_selected = {h[\'candidate_index\'] for h in history}\\n 40|     \\n 41|     # Get all available candidate indices\\n 42|     all_indices = list(range(len(candidates)))\\n 43|     available_indices = [idx for idx in all_indices if idx not in already_selected]\\n 44|     \\n 45|     # If no history or not enough candidates, return random selection\\n 46|     if not history or len(available_indices) <= batch_size:\\n 47|         selected = rng.sample(available_indices, min(batch_size, len(available_indices)))\\n 48|         return selected\\n 49|     \\n 50|     # Build gene performance statistics\\n 51|     # Track hits and trials per gene\\n 52|     gene_stats = {}  # gene_name -> {\'hits\': int, \'trials\': int}\\n 53|     \\n 54|     for h in history:\\n 55|         idx = h[\'candidate_index\']\\n 56|         candidate = candidates[idx]\\n 57|         \\n 58|         # Get gene name\\n 59|         if \'gene\' in candidate:\\n 60|             gene = candidate[\'gene\']\\n 61|         elif \'gene_a\' in candidate:\\n 62|             gene = candidate[\'gene_a\']\\n 63|         else:\\n 64|             continue\\n 65|         \\n 66|         if gene not in gene_stats:\\n 67|             gene_stats[gene] = {\'hits\': 0, \'trials\': 0}\\n 68|         \\n 69|         gene_stats[gene][\'trials\'] += 1\\n 70|         if h.get(\'hit\', 0) == 1:\\n 71|             gene_stats[gene][\'hits\'] += 1\\n 72|     \\n 73|     # Thompson Sampling: Sample hit probabilities from Beta posterior\\n 74|     # Prior: Beta(1, 1) which is uniform [0, 1]\\n 75|     # Posterior: Beta(1 + hits, 1 + trials - hits)\\n 76|     gene_sampled_probs = {}\\n 77|     \\n 78|     for gene, stats in gene_stats.items():\\n 79|         hits = stats[\'hits\']\\n 80|         trials = stats[\'trials\']\\n 81|         # Sample from Beta posterior\\n 82|         sampled_prob = np.random.beta(1 + hits, 1 + trials - hits)\\n 83|         gene_sampled_probs[gene] = sampled_prob\