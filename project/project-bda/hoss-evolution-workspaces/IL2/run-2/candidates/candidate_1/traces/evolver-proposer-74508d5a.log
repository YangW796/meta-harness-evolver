_SUB = None\\n 21|     _GENE_TO_SUB = None\\n 22|     _SUB_TO_CAND_IDX = None\\n 23|     _CAND_GENE_SET = None\\n 24| \\n 25|     csv_path = Path(achilles_csv).expanduser().resolve()\\n 26|     if not csv_path.exists():\\n 27|         return False\\n 28| \\n 29|     try:\\n 30|         import pandas as pd\\n 31|     except Exception:\\n 32|         return False\\n 33| \\n 34|     try:\\n 35|         df = pd.read_csv(csv_path)\\n 36|     except Exception:\\n 37|         return False\\n 38| \\n 39|     if df.empty:\\n 40|         return False\\n 41| \\n 42|     gene_col = None\\n 43|     for c in [\\"gene\\", \\"Gene\\", \\"GENE\\", \\"symbol\\", \\"hgnc_symbol\\", \\"Unnamed: 0\\"]:\\n 44|         if c in df.columns:\\n 45|             gene_col = c\\n 46|             break\\n 47|     if gene_col is None:\\n 48|         gene_col = df.columns[0]\\n 49| \\n 50|     genes = [str(x).strip() for x in df[gene_col].tolist()]\\n 51|     feat_df = df.drop(columns=[gene_col], errors=\\"ignore\\")\\n 52|     feat_df = feat_df.select_dtypes(include=[\\"number\\"]).fillna(0.0)\\n 53|     feats = feat_df.to_numpy(dtype=np.float32, copy=False)\\n 54|     if feats.ndim != 2 or feats.shape[0] != len(genes) or feats.shape[1] == 0:\\n 55|         return False\\n 56| \\n 57|     norms = np.linalg.norm(feats, axis=1, keepdims=True)\\n 58|     norms = np.maximum(norms, 1e-8)\\n 59|     feats = feats / norms\\n 60| \\n 61|     ach_gene_to_row: dict[str, int] = {}\\n 62|     for i, g in enumerate(genes):\\n 63|         if g and g not in ach_gene_to_row:\\n 64|             ach_gene_to_row[g] = i\\n 65| \\n 66|     cand_gene_to_idx: dict[str, int] = {}\\n 67|     for i, g in enumerate(candidate_genes):\\n 68|         gg = str(g).strip()\\n 69|         if gg and gg not in cand_gene_to_idx:\\n 70|             cand_gene_to_idx[gg] = int(i)\\n 71| \\n 72|     sub_rows: list[int] = []\\n 73|     sub_to_cand_idx: list[int] = []\\n 74|     gene_to_sub: dict[str, int] = {}\\n 75|     for g, cand_idx i