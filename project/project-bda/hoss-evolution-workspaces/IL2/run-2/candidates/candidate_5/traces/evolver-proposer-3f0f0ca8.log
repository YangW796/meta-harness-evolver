mpling\\n 36|      \\"\\"\\"\\n 37| -    pass\\n 38| +    rng = random.Random(seed)\\n 39| +    np.random.seed(seed)\\n 40| +    \\n 41| +    # Get already selected indices\\n 42| +    already_selected = {h[\'candidate_index\'] for h in history}\\n 43| +    \\n 44| +    # Get all available candidate indices\\n 45| +    all_indices = list(range(len(candidates)))\\n 46| +    available_indices = [idx for idx in all_indices if idx not in already_selected]\\n 47| +    \\n 48| +    # If no history or not enough candidates, return random selection\\n 49| +    if not history or len(available_indices) <= batch_size:\\n 50| +        selected = rng.sample(available_indices, min(batch_size, len(available_indices)))\\n 51| +        return selected\\n 52| +    \\n 53| +    # Build gene performance statistics\\n 54| +    # Track hits and trials per gene\\n 55| +    gene_stats = {}  # gene_name -> {\'hits\': int, \'trials\': int}\\n 56| +    \\n 57| +    for h in history:\\n 58| +        idx = h[\'candidate_index\']\\n 59| +        candidate = candidates[idx]\\n 60| +        \\n 61| +        # Get gene name\\n 62| +        if \'gene\' in candidate:\\n 63| +            gene = candidate[\'gene\']\\n 64| +        elif \'gene_a\' in candidate:\\n 65| +            gene = candidate[\'gene_a\']\\n 66| +        else:\\n 67| +            continue\\n 68| +        \\n 69| +        if gene not in gene_stats:\\n 70| +            gene_stats[gene] = {\'hits\': 0, \'trials\': 0}\\n 71| +        \\n 72| +        gene_stats[gene][\'trials\'] += 1\\n 73| +        if h.get(\'hit\', 0) == 1:\\n 74| +            gene_stats[gene][\'hits\'] += 1\\n 75| +    \\n 76| +    # Thompson Sampling: Sample hit probabilities from Beta posterior\\n 77| +    # Prior: Beta(1, 1) which is uniform [0, 1]\\n 78| +    # Posterior: Beta(1 + hits, 1 + trials - hits)\\n 79| +    gene_sampled_probs = {}\\n 80| +    \\n 81| +    for gene, stats in gene_stats.items():\\n 82| +        hits = stats[\'hits\']\\n 83| +        trials = stats[\'trials\']\\n 84| +        # Sample from Beta posterior\\n 85| +        sampled_prob = np.random.beta(1 + hits, 1 + trials - hits)\\n 86| +        gene_sampled_probs[gene] = sampled_prob\\n 87| +    \\n 88| +    # Create candidate pool with Thompson Sampling scores\\n 89| +    candidate_pool = []\\n 90| +    \\n 91| +    # Add candidates corresponding to tested genes with sampled probabilities\\n 92| +    for h in history:\\n 93| +        idx = h[\'candidate_index\']\\n 94| +        if idx not in available_indices:\\n 95| +            continue\\n 96| +        \\n 97| +        candidate = candidates[idx]\\n 98| +        if \'gene\' in candidate:\\n 99| +            gene = candidate[\'gene\']\\n100| +        elif \'gene_a\' in candidate:\\n101| +            gene = candidate[\'gene_a\']\\n102| +        else:\\n103| +            continue\\n104| +        \\n105| +        if gene in gene_sampled_probs:\\n106| +            candidate_pool.append((idx, gene_sampled_probs[gene]))\\n107| +    \\n108| +    # Try to use gene search to expand pool with similar genes\\n109| +    try:\\n110| +        import bda_tools\\n111| +        \\n112| +        # Sort genes by sampled probability (descending)\\n113| +        sorted_genes = sorted(gene_sampled_probs.items(), key=lambda x: x[1], reverse=True)\\n114| +        \\n115| +        # Search similar genes for top performers\\n116| +        genes_seen = set()\\n117| +        for gene, prob in sorted_genes[:max(10, len(sorted_genes) // 5)]:\\n118| +            if gene in genes_seen:\\n119| +                continue\\n120| +            genes_seen.add(gene)\\n121| +            \\n122| +            try:\\n123| +                # Search for similar genes\\n124| +                similar_indices = bda_tools.gene_search(gene, k=10, diverse=False)\\n125| +                \\n126| +                # Assign Thompson Sampling score to similar genes\\n127| +                # Use the sampled probability of the query gene\\n128| +            