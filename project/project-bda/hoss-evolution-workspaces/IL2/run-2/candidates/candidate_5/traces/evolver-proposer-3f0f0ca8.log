s = stats[\'trials\']\\n 84| +        # Sample from Beta posterior\\n 85| +        sampled_prob = np.random.beta(1 + hits, 1 + trials - hits)\\n 86| +        gene_sampled_probs[gene] = sampled_prob\\n 87| +    \\n 88| +    # Create candidate pool with Thompson Sampling scores\\n 89| +    candidate_pool = []\\n 90| +    \\n 91| +    # Add candidates corresponding to tested genes with sampled probabilities\\n 92| +    for h in history:\\n 93| +        idx = h[\'candidate_index\']\\n 94| +        if idx not in available_indices:\\n 95| +            continue\\n 96| +        \\n 97| +        candidate = candidates[idx]\\n 98| +        if \'gene\' in candidate:\\n 99| +            gene = candidate[\'gene\']\\n100| +        elif \'gene_a\' in candidate:\\n101| +            gene = candidate[\'gene_a\']\\n102| +        else:\\n103| +            continue\\n104| +        \\n105| +        if gene in gene_sampled_probs:\\n106| +            candidate_pool.append((idx, gene_sampled_probs[gene]))\\n107| +    \\n108| +    # Try to use gene search to expand pool with similar genes\\n109| +    try:\\n110| +        import bda_tools\\n111| +        \\n112| +        # Sort genes by sampled probability (descending)\\n113| +        sorted_genes = sorted(gene_sampled_probs.items(), key=lambda x: x[1], reverse=True)\\n114| +        \\n115| +        # Search similar genes for top performers\\n116| +        genes_seen = set()\\n117| +        for gene, prob in sorted_genes[:max(10, len(sorted_genes) // 5)]:\\n118| +            if gene in genes_seen:\\n119| +                continue\\n120| +            genes_seen.add(gene)\\n121| +            \\n122| +            try:\\n123| +                # Search for similar genes\\n124| +                similar_indices = bda_tools.gene_search(gene, k=10, diverse=False)\\n125| +                \\n126| +                # Assign Thompson Sampling score to similar genes\\n127| +                # Use the sampled probability of the query gene\\n128| +            