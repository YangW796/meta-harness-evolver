e_scores[idx] / candidate_counts[idx]\\n 67|     \\n 68|     # Calculate total number of observations for UCB exploration bonus\\n 69|     total_observations = len(history)\\n 70|     \\n 71|     # For each available candidate, calculate UCB score\\n 72|     # UCB = mean + sqrt(2 * ln(total_observations) / count)\\n 73|     # For unexplored candidates, count = 1 for optimistic initialization\\n 74|     ucb_scores = []\\n 75|     \\n 76|     # Calculate min and max observed scores for exploration\\n 77|     min_observed_score = min(candidate_avg_scores.values()) if candidate_avg_scores else 0\\n 78|     max_observed_score = max(candidate_avg_scores.values()) if candidate_avg_scores else 0\\n 79|     \\n 80|     for idx in available_indices:\\n 81|         if idx in candidate_avg_scores:\\n 82|             # Explored candidate\\n 83|             mean_score = candidate_avg_scores[idx]\\n 84|             count = candidate_counts[idx]\\n 85|             exploration_bonus = np.sqrt(2 * np.log(total_observations) / count) if total_observations > 0 else 0\\n 86|             ucb = mean_score + exploration_bonus\\n 87|         else:\\n 88|             # Unexplored candidate - use optimistic initialization\\n 89|             # Explore both extremes: favor candidates that could be very negative (hits) or very positive\\n 90|             # Use a mixture of min and max with higher weight on min since hits are negative\\n 91|             if candidate_avg_scores:\\n 92|                 # Bias exploration toward negative scores (hits are at -0.4 to -0.5)\\n 93|                 ucb_negative = min_observed_score - 0.1 * abs(min_observed_score) if min_observed_score != 0 else -1.0\\n 94|                 ucb_positive = max_observed_score + 0.1 * abs(max_observed_score) if max_observed_score != 0 else 1.0\\n 95|                 # Blend: 80% weight on negative exploration (hits), 20% on positive\\n 96|                 ucb = 0.8 * ucb_negative + 0.2 * ucb_positive\\n 97|             else:\