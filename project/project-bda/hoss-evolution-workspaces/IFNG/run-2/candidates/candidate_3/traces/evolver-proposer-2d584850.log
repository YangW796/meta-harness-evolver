\\n 38|      - seed: int\\n 39| -\\n 40| +    \\n 41|      Output:\\n 42|      - list[int] of NEW candidate indices (no repeats; already-selected may be ignored/replaced by runner).\\n 43| +    \\n 44| +    Strategy: Improved Thompson Sampling with adaptive exploration and hit-based exploitation.\\n 45| +    \\"\\"\\"\\n 46| +    rng = random.Random(seed)\\n 47| +    np.random.seed(seed)\\n 48| +    \\n 49| +    # Get all candidate indices\\n 50| +    all_indices = list(range(len(candidates)))\\n 51| +    \\n 52| +    # Get already selected indices\\n 53| +    selected_indices = {h[\'candidate_index\'] for h in history}\\n 54| +    \\n 55| +    # Get available indices (not yet selected)\\n 56| +    available_indices = [i for i in all_indices if i not in selected_indices]\\n 57| +    \\n 58| +    # If no history, use random selection\\n 59| +    if not history:\\n 60| +        selected = available_indices[:batch_size]\\n 61| +        rng.shuffle(selected)\\n 62| +        return selected[:batch_size]\\n 63| +    \\n 64| +    # Separate hits from non-hits for better modeling\\n 65| +    hit_indices = [h[\'candidate_index\'] for h in history if h.get(\'hit\', 0) == 1]\\n 66| +    hit_scores = [h[\'score\'] for h in history if h.get(\'hit\', 0) == 1]\\n 67| +    \\n 68| +    # If we have hits, prioritize exploring similar genes\\n 69| +    if hit_indices and len(hit_indices) > 0:\\n 70| +        # Try to use gene search if available\\n 71| +        try:\\n 72| +            import bda_tools\\n 73| +            \\n 74| +            # Find the best hit (most negative score)\\n 75| +            best_hit_idx = hit_indices[np.argmin(hit_scores)]\\n 76| +            best_hit_gene = candidates[best_hit_idx].get(\'gene\')\\n 77| +            \\n 78| +            if best_hit_gene:\\n 79| +                # Search for similar genes\\n 80| +                similar_indices = bda_tools.gene_search(best_hit_gene, k=20, diverse=False)\\n 81| +                \\n 82| +                # F