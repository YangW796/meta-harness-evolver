a distribution.\\"\\"\\"\\n122| +    \\n123| +    # Filter out excluded indices\\n124| +    available = [idx for idx in available_indices if idx not in exclude_indices]\\n125| +    \\n126| +    if len(available) <= batch_size:\\n127| +        return available[:batch_size]\\n128| +    \\n129| +    # Normalize scores to [0, 1] for Beta distribution\\n130| +    # Hits have negative scores around -0.4 to -0.5, we want these to have low normalized scores\\n131| +    all_scores = [h[\'score\'] for h in history]\\n132| +    min_score = min(all_scores)\\n133| +    max_score = max(all_scores)\\n134| +    score_range = max_score - min_score\\n135| +    \\n136| +    # Build success/failure counts for each candidate\\n137| +    # For Thompson Sampling with Beta distribution, we model the probability of \\"success\\"\\n138| +    # Here \\"success\\" means being a hit (having a very negative score)\\n139| +    candidate_successes = {}\\n140| +    candidate_failures = {}\\n141| +    \\n142| +    for h in history:\\n143| +        idx = h[\'candidate_index\']\\n144| +        score = h[\'score\']\\n145| +        \\n146| +        # Normalize score to [0, 1] where 0 is worst (most negative) and 1 is best\\n147| +        if score_range > 0:\\n148| +            normalized_score = (score - min_score) / score_range\\n149| +        else:\\n150| +            normalized_score = 0.5\\n151| +        \\n152| +        # For hits (very negative scores), normalized_score will be close to 0\\n153| +        # We define \\"success\\" as finding a hit, so we want to maximize (1 - normalized_score)\\n154| +        # The more negative the score, the higher the success probability\\n155| +        \\n156| +        if idx not in candidate_successes:\\n157| +            candidate_successes[idx] = 0\\n158| +            candidate_failures[idx] = 0\\n159| +        \\n160| +        # Accumulate successes and failures based on normalized score\\n161| +        # Use the complement since hits (what we want) have low normalized scores\\n162| +        success_weight = 1.0 - normalized_score\\n163| +        failure_weight = normalized_score\\n164| +        \\n165| +        # Add to counts (with some scaling to get reasonable Beta parameters)\\n166| +        candidate_successes[idx] += success_weight\\n167| +        candidate_failures[idx] += failure_weight\\n168| +    \\n169| +    # For Thompson Sampling, we sample from Beta(alpha, beta) for each candidate\\n170| +    # where alpha = successes + 1, beta = failures + 1 (add-1 smoothing for uninformed prior)\\n171| +    thompson_samples = []\\n172| +    \\n173| +    for idx in available:\\n174| +        if idx in candidate_successes:\\n175| +            # Explored candidate: use observed successes/failures\\n176| +            alpha = candidate_successes[idx] + 1\\n177| +            beta = candidate_failures[idx] + 1\\n178| +        else:\\n179| +            # Unexplored candidate: use optimistic prior\\n180| +            # Bias toward exploration of potentially good candidates (hits)\\n181| +            # Use alpha > beta to favor success (finding hits)\\n182| +            alpha = 4  # Slightly higher than before for more optimism\\n183| +            beta = 1\\n184| +        \\n185| +        # Sample from Beta distribution\\n186| +        sample = np.random.beta(alpha, beta)\\n187| +        thompson_samples.append((sample, idx))\\n188| +    \\n189| +    # Sort by Thompson sample (descending) and select top batch_size\\n190| +    thompson_samples.sort(reverse=True)\\n191| +    selected = [idx for _, idx in thompson_samples[:batch_size]]\\n192| +    \\n193| +    return selected\\n194| ```\\n195| \\n196| ### outputs/metrics.json\\n197| \\n198| ```diff\\n199| --- best/outputs/metrics.json\\n200| +++ candidate/outputs/metrics.json\\n201| @@ -0,0 +1,2233 @@\\n202| +{\\n203| +  \\"task\\": \\"perturb-genes-brief\\",\\n204| +  \\"data_name\\": \\"IFNG\\",\\n205| +  \\"measurement\\": \\"the log fold change in Interferon-gamma (IFNG) norma