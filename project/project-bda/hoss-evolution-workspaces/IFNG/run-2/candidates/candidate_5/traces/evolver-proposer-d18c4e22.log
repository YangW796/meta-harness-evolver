r).\\n 43| +    \\n 44| +    Strategy: Improved Thompson Sampling with adaptive exploration and hit-based exploitation.\\n 45| +    \\"\\"\\"\\n 46| +    rng = random.Random(seed)\\n 47| +    np.random.seed(seed)\\n 48| +    \\n 49| +    # Get all candidate indices\\n 50| +    all_indices = list(range(len(candidates)))\\n 51| +    \\n 52| +    # Get already selected indices\\n 53| +    selected_indices = {h[\'candidate_index\'] for h in history}\\n 54| +    \\n 55| +    # Get available indices (not yet selected)\\n 56| +    available_indices = [i for i in all_indices if i not in selected_indices]\\n 57| +    \\n 58| +    # If no history, use random selection\\n 59| +    if not history:\\n 60| +        selected = available_indices[:batch_size]\\n 61| +        rng.shuffle(selected)\\n 62| +        return selected[:batch_size]\\n 63| +    \\n 64| +    # Separate hits from non-hits for better modeling\\n 65| +    hit_indices = [h[\'candidate_index\'] for h in history if h.get(\'hit\', 0) == 1]\\n 66| +    hit_scores = [h[\'score\'] for h in history if h.get(\'hit\', 0) == 1]\\n 67| +    \\n 68| +    # If we have hits, prioritize exploring similar genes\\n 69| +    if hit_indices and len(hit_indices) > 0:\\n 70| +        # Try to use gene search if available\\n 71| +        try:\\n 72| +            import bda_tools\\n 73| +            \\n 74| +            # Find the best hit (most negative score)\\n 75| +            best_hit_idx = hit_indices[np.argmin(hit_scores)]\\n 76| +            best_hit_gene = candidates[best_hit_idx].get(\'gene\')\\n 77| +            \\n 78| +            if best_hit_gene:\\n 79| +                # Search for similar genes\\n 80| +                similar_indices = bda_tools.gene_search(best_hit_gene, k=20, diverse=False)\\n 81| +                \\n 82| +                # Filter to available indices only\\n 83| +                similar_available = [idx for idx in similar_indices if idx in available_indices]\\n 84| +                \\n 85| +                # If we found similar genes, include some in the selection\\n 86| +                if similar_available:\\n 87| +                    # Take up to 30% of batch from similar genes\\n 88| +                    num_similar = min(len(similar_available), batch_size // 3)\\n 89| +                    selected = similar_available[:num_similar]\\n 90| +                    remaining_batch = batch_size - len(selected)\\n 91| +                    \\n 92| +                    # Fill the rest using Thompson Sampling\\n 93| +                    if remaining_batch > 0:\\n 94| +                        thompson_selected = _thompson_sampling(\\n 95| +                            candidates, history, available_indices, \\n 96| +                            selected, remaining_batch, rng\\n 97| +                        )\\n 98| +                        selected.extend(thompson_selected)\\n 99| +                    \\n100| +                    rng.shuffle(selected)\\n101| +                    return selected[:batch_size]\\n102| +        except ImportError:\\n103| +            # Gene search not available, fall back to pure Thompson Sampling\\n104| +            pass\\n105| +        except Exception:\\n106| +            # Gene search failed, fall back to pure Thompson Sampling\\n107| +            pass\\n108| +    \\n109| +    # Use pure Thompson Sampling\\n110| +    selected = _thompson_sampling(candidates, history, available_indices, [], batch_size, rng)\\n111| +    rng.shuffle(selected)\\n112| +    return selected[:batch_size]\\n113|  \\n114| -    You may implement any suitable algorithmic model here, including but not limited to:\\n115| -    traditional algorithms, machine learning models, deep learning models, biological models,\\n116| -    and mathematical models.\\n117| -    \\"\\"\\"\\n118| -    pass\\n119| +\\n120| +def _thompson_sampling(candidates, history, available_indices, exclude_indices, batch_size, rng):\\n121| +    \\"\\"\\"Helper function for Thompson Sampling with Beta distribution.\\"\\"\\"\\n122| +    \\n123| +    # Filter out excluded indices\\n124| +    available = [idx for idx in available_indices if idx not in exclude_indices]\\n125| +    \\n126| +    if len(available) <= batch_size:\\n127| +        return available[:batch_size]\\n128| +    \\n129| +    # Normalize scores to [0, 1] for Beta distribution\\n130| +    # Hits have negative scores around -0.4 to -0.5, we want these to have low normalized scores\\n131| +    all_scores = [h[\'score\'] for h in history]\\n132| +    min_score = min(all_scores)\\n133| +    max_score = max(all_scores)\\n134| +    score_range = max_score - min_score\\n135| +    \\n136| +    # Build success/failure counts for each candidate\\n137| +    # For Thompson Sampling with Beta distribution, we model the probability of \\"success\\"\\n138| +    # Here \\"success\\" means being a hit (having a very negative score)\\n139| +    candidate_successes = {}\\n140| +    candidate_failures = {}\\n141| +    \\n142| +    for h in history:\\n143| +        idx = h[\'candidate_index\']\\n144| +        score = h[\'score\']\\n145| +        \\n146| +        # Normalize score to [0, 1] where 0 is worst (most negative) and 1 is best\\n147| +        if score_range > 0:\\n148| +            normalized_score = (score - min_score) / score_range\\n149| +        else:\\n150| +            normalized_score = 0.5\\n151| +        \\n152| +        # For hits (very negative scores), normalized_score will be close to 0\\n153| +        # We define \\"success\\" as finding a hit, so we want to maximize (1 - normalized_score)\\n154| +        # The more negative the score, the higher the success probability\\n155| +        \\n156| +        if idx not in candidate_successes:\\n157| +            candidate_successes[idx] = 0\\n158| +            candidate_failures[idx] = 0\\n159| +        \\n160| +        # Accumulate successes and failures based on normalized score\\n161| +        # Use the complement since hits (what we want) have low normalized scores\\n162| +        success_weight = 1.0 - normalized_score\\n163| +        failure_weight = normalized_score\\n164| +        \\n165| +        # Add to counts (with some scaling to get reasonable Beta parameters)\\n166| +        candidate_successes[idx] += success_weight\\n167| +        candidate_failures[idx] += failure_weight\\n168| +    \\n169| +    # For Thompson Sampling, we sample from Beta(alpha, beta) for each candidate\\n170| +    # where alpha = successes + 1, beta = failures + 1 (add-1 smoothing for uninformed prior)\\n171| +    thompson_samples = []\\n172| +    \\n173| +    for idx in available:\\n174| +        if idx in candidate_successes:\\n175| +            # Explored candidate: use observed successes/failures\\n176| +            alpha = candidate_successes[idx] + 1\\n177| +            beta = candidate_failures[idx] + 1\\n178| +        else:\\n179| +            # Unexplored candidate: use optimistic prior\\n180| +            # Bias toward exploration of potentially good candidates (hits)\\n181| +            # Use alpha > beta to favor success (finding hits)\\n182| +            alpha = 4  # Slightly higher than before for more optimism\\n183| +            beta = 1\\n184| +        \\n185| +        # Sample from Beta distribution\\n186| +        sample = np.random.beta(alpha, beta)\\n187| +        thompson_samples.append((sample, idx))\\n188| +    \\n189| +    # Sort by Thompson sample (descending) and select top batch_size\\n190| +    thompson_samples.sort(reverse=True)\\n191| +    selected = [idx for _, idx in thompson_samples[:batch_size]]\\n192| +    \\n193| +    return selected\\n194| ```\\n195| \\n196| ### outputs/metrics.json\\n197| \\n198| ```diff\\n199| --- best/outputs/metrics.json\\n200| +++ candidate/outputs/metrics.json\\n201| @@ -0,0 +1,2233 @@\\n202| +{\\n203| +  \\"task\\": \\"perturb-genes-brief\\",\\n204| +  \\"data_name\\": \\"IFNG\\",\\n205| +  \\"measurement\\": \\"the log fold change in Interferon-gamma (IFNG) norma