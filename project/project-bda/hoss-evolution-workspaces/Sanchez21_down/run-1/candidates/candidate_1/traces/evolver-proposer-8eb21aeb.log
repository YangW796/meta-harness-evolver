= max(10, len(sorted_history) // 5)\\n 61|         top_performers = [h[\'candidate_index\'] for h in sorted_history[:top_k]]\\n 62|         \\n 63|         # Sample from top performers\\n 64|         selected_indices = []\\n 65|         remaining = available.copy()\\n 66|         \\n 67|         # Take some top performers if available\\n 68|         top_available = [idx for idx in top_performers if idx in remaining]\\n 69|         if top_available:\\n 70|             n_top = min(len(top_available), batch_size // 2)\\n 71|             selected_indices.extend(rng.sample(top_available, n_top))\\n 72|             remaining = [i for i in remaining if i not in selected_indices]\\n 73|         \\n 74|         # Fill rest with random exploration\\n 75|         if len(selected_indices) < batch_size:\\n 76|             needed = batch_size - len(selected_indices)\\n 77|             selected_indices.extend(rng.sample(remaining, min(needed, len(remaining))))\\n 78|         \\n 79|         return selected_indices[:batch_size]\\n 80|     \\n 81|     # Thompson Sampling with Gene Cluster Priors\\n 82|     # Group candidates into clusters based on gene similarity\\n 83|     clusters = defaultdict(list)\\n 84|     candidate_to_cluster = {}\\n 85|     \\n 86|     # Try to use gene search to create clusters\\n 87|     try:\\n 88|         import bda_tools\\n 89|         \\n 90|         # Create clusters for all candidates we have history for\\n 91|         for h in history:\\n 92|             idx = h[\'candidate_index\']\\n 93|             candidate = candidates[idx]\\n 94|             gene = candidate.get(\'gene\') or candidate.get(\'gene_a\')\\n 95|             \\n 96|             if gene and idx not in candidate_to_cluster:\\n 97|                 # Find similar genes\\n 98|                 try:\\n 99|                     similar = bda_tools.gene_search(gene, k=20, diverse=False)\\n100|                     cluster_id = f\\"cluster_{gene}\\"\\n101|                     \\n102|          