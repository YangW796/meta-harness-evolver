ndom\\n  3| import numpy as np\\n  4| from collections import defaultdict\\n  5| \\n  6| def select(candidates, history, batch_size, seed) -> list[int]:\\n  7|     \\"\\"\\"\\n  8|     Selection policy for Project-BDA.\\n  9| \\n 10|     Contract (MUST KEEP EXACTLY):\\n 11|         select(candidates, history, batch_size, seed) -> list[int]\\n 12| \\n 13|     Inputs:\\n 14|     - candidates: list[dict]\\n 15|         - single-gene datasets: each item includes {\\"gene\\": \\"<HGNC>\\"}\\n 16|         - gene-pair datasets: each item includes {\\"gene_a\\": \\"<HGNC>\\", \\"gene_b\\": \\"<HGNC>\\"}\\n 17|         - gene search (optional): when enabled by the runner, you may call:\\n 18|           - import bda_tools\\n 19|           - bda_tools.gene_search(query_gene: str, k: int = 10, diverse: bool = False) -> list[int]\\n 20|     - history: list[dict]\\n 21|         - each item includes at least:\\n 22|           - candidate_index: int\\n 23|           - score: float\\n 24|           - hit: int (0/1) if enabled by runner\\n 25|     - batch_size: int\\n 26|     - seed: int\\n 27| \\n 28|     Output:\\n 29|     - list[int] of NEW candidate indices (no repeats; already-selected may be ignored/replaced by runner).\\n 30|     \\n 31|     Strategy: Thompson Sampling with Gene Cluster Priors\\n 32|     - Uses Thompson Sampling (Bayesian bandit algorithm) for adaptive exploration-exploitation\\n 33|     - Models each candidate with Beta distribution based on hit observations\\n 34|     - Uses gene search to create clusters and share information via Bayesian priors\\n 35|     - Enhanced fallback: Uses gene name prefix clustering when gene search unavailable\\n 36|     - Naturally balances exploration vs exploitation based on uncertainty\\n 37|     \\"\\"\\"\\n 38|     rng = random.Random(seed)\\n 39|     np.random.seed(seed)\\n 40|     \\n 41|     # Get already selected indices\\n 42|     selected = set(h[\'candidate_index\'] for h in history)\\n 43|     \\n 44|     # Get all available candidate indices\\n 45|     all_indices = list(range(len(candidates)))\\n 46|     available = [i for i in all_indices if i not in selected]\\n 47|     \\n 48|     if len(available) <= batch_size:\\n 49|         return available\\n 50|     \\n 51|     # If no history, use pure exploration\\n 52|     if len(history) == 0:\\n 53|         return rng.sample(available, batch_size)\\n 54|     \\n 55|     # Check if hit information is available\\n 56|     has_hits = any(\'hit\' in h for h in history)\\n 57|     \\n 58|     if not has_hits:\\n 59|         # Fall back to score-based selection using absolute scores\\n 60|         sorted_history = sorted(history, key=lambda x: abs(x[\'score\']), reverse=True)\\n 61|         top_k = max(10, len(sorted_history) // 5)\\n 62|         top_performers = [h[\'candidate_index\'] for h in sorted_history[:top_k]]\\n 63|         \\n 64|         # Sample from top performers\\n 65|         selected_indices = []\\n 66|         remaining = available.copy()\\n 67|         \\n 68|         # Take some top performers if available\\n 69|         top_available = [idx for idx in top_performers if idx in remaining]\\n 70|         if top_available:\\n 71|             n_top = min(len(top_available), batch_size // 2)\\n 72|             selected_indices.extend(rng.sample(top_available, n_top))\\n 73|             remaining = [i for i in remaining if i not in selected_indices]\\n 74|         \\n 75|         # Fill rest with random exploration\\n 76|         if len(selected_indices) < batch_size:\\n 77|             needed = batch_size - len(selected_indices)\\n 78|             selected_indices.extend(rng.sample(remaining, min(needed, len(remaining))))\\n 79|         \\n 80|         return selected_indices[:batch_size]\\n 81|     \\n 82|     # Enhanced Thompson Sampling with Continuous Score Modeling\\n 83|     # Use Gaussian-Gamma model for continuous scores instead of Beta for binary hits\\n 84|     \\n 85|     # Group candidates into clusters based on gene similarity\\n 86|     clusters = defaultdict(list)\\n 87|     candidate_to_cluster = {}\\n 88|     \\n 89|     # Try to use gene search to create clusters\\n 90|     try:\\n 91|         import bda_tools\\n 92|         \\n 93|         # Create clusters for all candidates we have history for\\n 94|         for h in history:\\n 95|             idx = h[\'candidate_index\']\\n 96|             candidate = candidates[idx]\\n 97|             gene = candidate.get(\'gene\') or candidate.get(\'gene_a\')\\n 98|             \\n 99|             if gene and idx not in candidate_to_cluster:\\n100|                 # Find similar genes\\n101|                 try:\\n102|                     similar = bda_tools.gene_search(gene, k=20, diverse=False)\\n103|                     cluster_id = f\\"cluster_{gene}\\"\\n104|                     \\n105|                     for sim_idx in similar:\\n106|                         if sim_idx not in candidate_to_cluster:\\n107|                             candidate_to_cluster[sim_idx] = cluster_id\\n108|                             clusters[cluster_id].append(sim_idx)\\n109|                 except:\\n110|                     # If gene search fails, put in singleton cluster\\n111|                     cluster_id = f\\"singleton_{idx}\\"\\n112|                     candidate_to_cluster[idx] = cluster_id\\n113|                     clusters[cluster_id] = [idx]\\n114|         \\n115|         # Assign unassigned candidates to singleton clusters\\n116|         for idx in all_indices:\\n117|             if idx not in candidate_to_cluster:\\n118|                 cluster_id = f\\"singleton_{idx}\\"\\n119|                 candidate_to_cluster[idx] = cluster_id\\n120|                 clusters[cluster_id] = [idx]\\n121|                 \\n122|     except ImportError:\\n123|         # No gene search available - use enhanced fallback: gene family prefix clustering\\n124|         # Group genes by name prefix to capture gene families (e.g., ZNF, ZSCAN, TNF, etc.)\\n125|         gene_to_prefix = {}\\n126|         \\n127|         for idx in all_indices:\\n128|             candidate = candidates[idx]\\n129|             gene = candidate.get(\'gene\') or candidate.get(\'gene_a\')\\n130|             if gene:\\n131|                 # Extract prefix: typically first 3-4 letters before numbers\\n132|                 # This captures gene families like ZNF, ZSCAN, TNF, IL, etc.\\n133|                 prefix = \'\'.join([c for c in gene if not c.isdigit()])[:4]\\n134|                 if len(prefix) >= 2:\\n135|                     gene_to_prefix[idx] = f\\"family_{prefix}\\"\\n136|                 else:\\n137|                     gene_to_prefix[idx] = f\\"singleton_{idx}\\"\\n138|             else:\\n139|                 gene_to_prefix[idx] = f\\"singleton_{idx}\\"\\n140|         \\n141|         # Create clusters based on prefix\\n142|         for idx, prefix in gene_to_prefix.items():\\n143|             candidate_to_cluster[idx] = prefix\\n144|             clusters[prefix].append(idx)\\n145|     \\n146|     # Compute cluster statistics using continuous scores\\n147|     cluster_sums = defaultdict(float)\\n148|     cluster_sums_sq = defaultdict(float)\\n149|     cluster_counts = defaultdict(int)\\n150|     \\n151|     for h in history:\\n152|         idx = h[\'candidate_index\']\\n153|         cluster_id = candidate_to_cluster[idx]\\n154|         score = h[\'score\']\\n155|         \\n156|         cluster_sums[cluster_id] += score\\n157|         cluster_sums_sq[cluster_id] += score * score\\n158|         cluster_counts[cluster_id] += 1\\n159|     \\n160|     # Compute global statistics for empirical Bayes prior\\n161|     all_scores = [h[\'score\'] for h in history]\\n162|     global_mean = np.mean(all_scores) if all_scores else 0.0\\n163|     global_var = np.var(all_scores) if len(all_scores) > 1 else 1.0\\n164|     \\n165|     # Gaussian-Gamma prior parameters (uninformative but centered at global stats)\\n166|     mu_0 = global_mean  # Prior mean\\n167|     lambda_0 = 1.0      # Prior precision scaling\\n168|     alpha_0 = 1.0       # Prior shape for precision\\n169|     beta_0 = global_var if global_var > 0 else 1.0  # Prior rate for precision\\n170|     \\n171|     # For each cluster, compute posterior parameters\\n172|     cluster_posterior = {}\\n173|     \\n174|     for cluster_id in clusters:\\n175|         n = cluster_counts.get(cluster_id, 0)\\n176|         \\n177|         if n == 0:\\n178|             # No observations, use prior\\n179|             cluster_posterior[cluster_id] = {\\n180|                 \'mu_n\': mu_0,\\n181|                 \'lambda_n\': lambda_0,\\n182|                 \'alpha_n\': alpha_0,\\n183|                 \'beta_n\': beta_0\\n184|             }\\n185|         else:\\n186|             # Update posterior with cluster observations\\n187|             sum_x = cluster_sums[cluster_id]\\n188|             sum_x_sq = cluster_sums_sq[cluster_id]\\n189|             mean_x = sum_x / n\\n190|             \\n191|             # Gaussian-Gamma posterior update\\n192|             lambda_n = lambda_0 + n\\n193|             mu_n = (lambda_0 * mu_0 + sum_x) / lambda_n\\n194|             alpha_n = alpha_0 + n / 2.0\\n195|             beta_n = beta_0 + 0.5 * (sum_x_sq - (sum_x * sum_x) / n) + \\\\\\n196|                      (lambda_0 * n * (mean_x - mu_0) ** 2) / (2 * lambda_n)\\n197|             \\n198|             cluster_posterior[cluster_id] = {\\n199|                 \'mu_n\': mu_n,\\n200|                 \'lambda_n\': lambda_n,\\n201|                 \'alpha_n\': alpha_n,\\n202|                 \'beta_n\': beta_n\\n203|             }\\n204|     \\n205|     # For candidates with direct observations, compute posterior\\n206|     candidate_posterior = {}\\n207|     \\n208|     for h in history:\\n209|         idx = h[\'candidate_index\']\\n210|         score = h[\'score\']\\n211|         cluster_id = candidate_to_cluster[idx]\\n212|         cluster_post = cluster_posterior[cluster_id]\\n213|         \\n214|         # Conservative update: treat cluster prior as having stronger weight\\n215|         # This prevents overfitting to a single observation when cluster has limited data\\n216|         effective_prior_weight = max(cluster_post[\'lambda_n\'], 2.0)  # At least 2 pseudo-observations\\n217|         lambda_n = effective_prior_weight + 1\\n218|         mu_n = (effective_prior_weight * cluster_post[\'mu_n\'] + score) / lambda_n\\n219|         alpha_n = cluster_post[\'alpha_n\'] + 0.5\\n220|         beta_n = cluster_post[\'beta_n\'] + 0.5 * (score - cluster_post[\'mu_n\']) ** 2 * \\\\\\n221|                  effective_prior_weight / lambda_n\\n222|         \\n223|         candidate_posterior[idx] = {\\n224|             \'mu_n\': mu_n,\\n225|             \'lambda_n\': lambda_n,\\n226|             \'alpha_n\': alpha_n,\\n227|             \'beta_n\': beta_n\\n228|         }\\n229|     \\n230|     # Enhanced Thompson Sampling with explicit exploration bonus\\n231|     # Estimate total rounds from history to calibrate exploration\\n232|     observed_rounds = len(set(h.get(\'round\', 0) for h in history))\\n233|     total_rounds_estimate = max(5, observed_rounds + 1)  # At least 5 rounds expected\\n234|     \\n235|     # Exploration coefficient: higher early on, decays with rounds\\n236|     # Starts at 2.0 for round 1, decays to 0.5 by final round\\n237|     exploration_coeff = 2.0 * (1.0 - 0.75 * (observed_rounds / total_rounds_estimate))\\n238|     exploration_coeff = max(0.5, exploration_coeff)  # Minimum exploration\\n239|     \\n240|     sampled_scores = {}\\n241|     \\n242|     for idx in available:\\n243|         cluster_id = candidate_to_cluster[idx]\\n244|         \\n245|         if idx in candidate_posterior:\\n246|             # Candidate has been observed, use its posterior\\n247|             post = candidate_posterior[idx]\\n248|         else:\\n249|             # Candidate not observed, use cluster posterior\\n250|             post = cluster_posterior[cluster_id]\\n251|         \\n252|         # Sample precision from Gamma\\n253|         tau = np.random.gamma(post[\'alpha_n\'], 1.0 / post[\'beta_n\'])\\n254|         \\n255|         # Compute standard deviation (uncertainty)\\n256|         std_dev = 1.0 / np.sqrt(post[\'lambda_n\'] * tau)\\n257|         \\n258|         # Sample mean from Gaussian given precision\\n259|         mean_sample = np.random.normal(post[\'mu_n\'], std_dev)\\n260|         \\n261|         # Add exploration bonus: favor high-uncertainty candidates\\n262|         # For this task (more negative = better), subtract exploration term\\n263|         exploration_bonus = exploration_coeff * std_dev\\n264|         exploration_sample = mean_sample - exploration_bonus\\n265|         \\n266|         # Store sampled score with exploration bonus\\n267|         sampled_scores[idx] = exploration_sample\\n268|     \\n269|     # Select top candidates by sampled score (prioritize more negative values)\\n270|     sorted_by_sample = sorted(available, key=lambda x: sampled_scores[x])\\n271|     selected_indices = sorted_by_sample[:batch_size]\\n272|     \\n273|     return selected_indices"\n}'}, {'role': 'assistant', 'content': 'Now let me check the candidate_5 directory structure to prepare for writing:\n', 'tool_calls': [{'id': 'call_9b4510aaf3de46d88daebdd7', 'type': 'function', 'function': {'name': 'list_directory', 'arguments': '{"dir_path": "/inspire/qb-ilm/project/cq-scientific-cooperation-zone/public/ywang/meta-harness-evolver/project/test/project-bda/hoss-evolution-workspaces/Sanchez21_down/run-1/candidates/candidate_5"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_9b4510aaf3de46d88daebdd7', 'content': '{\n  "content": "Directory listing for /inspire/qb-ilm/project/cq-scientific-cooperation-zone/public/ywang/meta-harness-evolver/project/test/project-bda/hoss-evolution-workspaces/Sanchez21_down/run-1/candidates/candidate_5:\\n[DIR] harness\\n[DIR] traces"\n}'}, {'role': 'a