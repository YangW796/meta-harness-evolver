ne_to_prefix[idx] = f\\"family_{prefix}\\"\\n139| +                else:\\n140| +                    gene_to_prefix[idx] = f\\"singleton_{idx}\\"\\n141| +            else:\\n142| +                gene_to_prefix[idx] = f\\"singleton_{idx}\\"\\n143| +        \\n144| +        # Create clusters based on prefix\\n145| +        for idx, prefix in gene_to_prefix.items():\\n146| +            candidate_to_cluster[idx] = prefix\\n147| +            clusters[prefix].append(idx)\\n148| +    \\n149| +    # Compute cluster statistics (empirical Bayes priors)\\n150| +    cluster_successes = defaultdict(int)\\n151| +    cluster_trials = defaultdict(int)\\n152| +    \\n153| +    for h in history:\\n154| +        idx = h[\'candidate_index\']\\n155| +        cluster_id = candidate_to_cluster[idx]\\n156| +        cluster_trials[cluster_id] += 1\\n157| +        if h.get(\'hit\') == 1:\\n158| +            cluster_successes[cluster_id] += 1\\n159| +    \\n160| +    # Compute global prior from all history\\n161| +    total_hits = sum(1 for h in history if h.get(\'hit\') == 1)\\n162| +    global_alpha = total_hits + 1\\n163| +    global_beta = len(history) - total_hits + 1\\n164| +    \\n165| +    # For each cluster, compute posterior parameters\\n166| +    cluster_alpha = {}\\n167| +    cluster_beta = {}\\n168| +    \\n169| +    for cluster_id in clusters:\\n170| +        successes = cluster_successes.get(cluster_id, 0)\\n171| +        trials = cluster_trials.get(cluster_id, 0)\\n172| +        \\n173| +        # Use global prior with cluster observations\\n174| +        # This is empirical Bayes: use global distribution as prior\\n175| +        cluster_alpha[cluster_id] = successes + global_alpha\\n176| +        cluster_beta[cluster_id] = (trials - successes) + global_beta\\n177| +    \\n178| +    # For candidates with direct observations, compute posterior\\n179| +    candidate_alpha = {}\\n180| +    candidate_beta = {}\\n181| +    \\n182| +    for h in history:\\n183| +        idx = h[\'candidate_index\']\\n184| +        hit = h.get(\'hit\', 0)\\n185| +        cluster_id = candidate_to_cluster[idx]\\n186| +        \\n187| +        # Start with cluster prior, update with direct observation\\n188| +        candidate_alpha[idx] = hit + cluster_alpha[cluster_id]\\n189| +        candidate_beta[idx] = (1 - hit) + cluster_beta[cluster_id]\\n190| +    \\n191| +    # Thompson Sampling: sample theta for each candidate and select top ones\\n192| +    sampled_probs = {}\\n193| +    \\n194| +    for idx in available:\\n195| +        cluster_id = candidate_to_cluster[idx]\\n196| +        \\n197| +        if idx in candidate_alpha:\\n198| +            # Candidate has been observed, use its posterior\\n199| +            alpha = candidate_alpha[idx]\\n200| +            beta = candidate_beta[idx]\\n201| +        else:\\n202| +            # Candidate not observed, use cluster posterior\\n203| +            alpha = cluster_alpha[cluster_id]\\n204| +            beta = cluster_beta[cluster_id]\\n205| +        \\n206| +        # Sample from Beta distribution\\n207| +        sampled_probs[idx] = np.random.beta(alpha, beta)\\n208| +    \\n209| +    # Select top candidates by sampled probability\\n210| +    sorted_by_sample = sorted(available, key=lambda x: sampled_probs[x], reverse=True)\\n211| +    selected_indices = sorted_by_sample[:batch_size]\\n212| +    \\n213| +    return selected_indices\\n214| ```\\n215| \\n216| ### outputs/metrics.json\\n217| \\n218| ```diff\\n219| --- best/outputs/metrics.json\\n220| +++ candidate/outputs/metrics.json\\n221| @@ -0,0 +1,2233 @@\\n222| +{\\n223| +  \\"task\\": \\"perturb-genes-brief\\",\\n224| +  \\"data_name\\": \\"Sanchez21_down\\",\\n225| +  \\"measurement\\": \\"the change in tau protein level compared to the non-targeting control, using a total tau antibody\\",\\n226| +  \\"task_prompt\\": {\\n227| +    \\"Task\\": \\"identify genes that, when knocked out, decrease expression of endogenous tau protein levels in neurons\\",\\n22