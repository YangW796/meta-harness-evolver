uster[sim_idx] = cluster_id\\n111| +                            clusters[cluster_id].append(sim_idx)\\n112| +                except:\\n113| +                    # If gene search fails, put in singleton cluster\\n114| +                    cluster_id = f\\"singleton_{idx}\\"\\n115| +                    candidate_to_cluster[idx] = cluster_id\\n116| +                    clusters[cluster_id] = [idx]\\n117| +        \\n118| +        # Assign unassigned candidates to singleton clusters\\n119| +        for idx in all_indices:\\n120| +            if idx not in candidate_to_cluster:\\n121| +                cluster_id = f\\"singleton_{idx}\\"\\n122| +                candidate_to_cluster[idx] = cluster_id\\n123| +                clusters[cluster_id] = [idx]\\n124| +                \\n125| +    except ImportError:\\n126| +        # No gene search available - use enhanced fallback: gene family prefix clustering\\n127| +        # Group genes by name prefix to capture gene families (e.g., ZNF, ZSCAN, TNF, etc.)\\n128| +        gene_to_prefix = {}\\n129| +        \\n130| +        for idx in all_indices:\\n131| +            candidate = candidates[idx]\\n132| +            gene = candidate.get(\'gene\') or candidate.get(\'gene_a\')\\n133| +            if gene:\\n134| +                # Extract prefix: typically first 3-4 letters before numbers\\n135| +                # This captures gene families like ZNF, ZSCAN, TNF, IL, etc.\\n136| +                prefix = \'\'.join([c for c in gene if not c.isdigit()])[:4]\\n137| +                if len(prefix) >= 2:\\n138| +                    gene_to_prefix[idx] = f\\"family_{prefix}\\"\\n139| +                else:\\n140| +                    gene_to_prefix[idx] = f\\"singleton_{idx}\\"\\n141| +            else:\\n142| +                gene_to_prefix[idx] = f\\"singleton_{idx}\\"\\n143| +        \\n144| +        # Create clusters based on prefix\\n145| +        for idx, prefix in gene_to_prefix.items():\\n146| +            candidate_to_cluster[idx] = prefix\\n147| +            clusters[prefix].append(idx)\\n148| +    \\n149| +    # Compute cluster statistics (empirical Bayes priors)\\n150| +    cluster_successes = defaultdict(int)\\n151| +    cluster_trials = defaultdict(int)\\n152| +    \\n153| +    for h in history:\\n154| +        idx = h[\'candidate_index\']\\n155| +        cluster_id = candidate_to_cluster[idx]\\n156| +        cluster_trials[cluster_id] += 1\\n157| +        if h.get(\'hit\') == 1:\\n158| +            cluster_successes[cluster_id] += 1\\n159| +    \\n160| +    # Compute global prior from all history\\n161| +    total_hits = sum(1 for h in history if h.get(\'hit\') == 1)\\n162| +    global_alpha = total_hits + 1\\n163| +    global_beta = len(history) - total_hits + 1\\n164| +    \\n165| +    # For each cluster, compute posterior parameters\\n166| +    cluster_alpha = {}\\n167| +    cluster_beta = {}\\n168| +    \\n169| +    for cluster_id in clusters:\\n170| +        successes = cluster_successes.get(cluster_id, 0)\\n171| +        trials = cluster_trials.get(cluster_id, 0)\\n172| +        \\n173| +        # Use global prior with cluster observations\\n174| +        # This is empirical Bayes: use global distribution as prior\\n175| +        cluster_alpha[cluster_id] = successes + global_alpha\\n176| +        cluster_beta[cluster_id] = (trials - successes) + global_beta\\n177| +    \\n178| +    # For candidates with direct observations, compute posterior\\n179| +    candidate_alpha = {}\\n180| +    candidate_beta = {}\\n181| +    \\n182| +    for h in history:\\n183| +        idx = h[\'candidate_index\']\\n184| +        hit = h.get(\'hit\', 0)\\n185| +        cluster_id = candidate_to_cluster[idx]\\n186| +        \\n187| +        # Start with cluster prior, update with direct observation\\n188| +        candidate_alpha[idx] = hit + cluster_alpha[cluster_id]\\n189| +        candidate_beta[idx] = (1 - hit) + cluster_beta[cluster_id]\\n190| +    \\n191| +    # Thompson Sampling: sample theta