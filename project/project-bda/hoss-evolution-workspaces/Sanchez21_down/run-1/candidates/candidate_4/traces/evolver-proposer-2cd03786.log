ble\\n 61| +    has_hits = any(\'hit\' in h for h in history)\\n 62| +    \\n 63| +    if not has_hits:\\n 64| +        # Fall back to score-based selection using absolute scores\\n 65| +        sorted_history = sorted(history, key=lambda x: abs(x[\'score\']), reverse=True)\\n 66| +        top_k = max(10, len(sorted_history) // 5)\\n 67| +        top_performers = [h[\'candidate_index\'] for h in sorted_history[:top_k]]\\n 68| +        \\n 69| +        # Sample from top performers\\n 70| +        selected_indices = []\\n 71| +        remaining = available.copy()\\n 72| +        \\n 73| +        # Take some top performers if available\\n 74| +        top_available = [idx for idx in top_performers if idx in remaining]\\n 75| +        if top_available:\\n 76| +            n_top = min(len(top_available), batch_size // 2)\\n 77| +            selected_indices.extend(rng.sample(top_available, n_top))\\n 78| +            remaining = [i for i in remaining if i not in selected_indices]\\n 79| +        \\n 80| +        # Fill rest with random exploration\\n 81| +        if len(selected_indices) < batch_size:\\n 82| +            needed = batch_size - len(selected_indices)\\n 83| +            selected_indices.extend(rng.sample(remaining, min(needed, len(remaining))))\\n 84| +        \\n 85| +        return selected_indices[:batch_size]\\n 86| +    \\n 87| +    # Thompson Sampling with Gene Cluster Priors\\n 88| +    # Group candidates into clusters based on gene similarity\\n 89| +    clusters = defaultdict(list)\\n 90| +    candidate_to_cluster = {}\\n 91| +    \\n 92| +    # Try to use gene search to create clusters\\n 93| +    try:\\n 94| +        import bda_tools\\n 95| +        \\n 96| +        # Create clusters for all candidates we have history for\\n 97| +        for h in history:\\n 98| +            idx = h[\'candidate_index\']\\n 99| +            candidate = candidates[idx]\\n100| +            gene = candidate.get(\'gene\') or candidate.get(\'gene_a\')\\n101| +            \\n102| +            if gene and idx not in candidate_to_cluster:\\n103| +                # Find similar genes\\n104| +                try:\\n105| +                    similar = bda_tools.gene_search(gene, k=20, diverse=False)\\n106| +                    cluster_id = f\\"cluster_{gene}\\"\\n107| +                    \\n108| +                    for sim_idx in similar:\\n109| +                        if sim_idx not in candidate_to_cluster:\\n110| +                            candidate_to_cluster[sim_idx] = cluster_id\\n111| +                            clusters[cluster_id].append(sim_idx)\\n112| +                except:\\n113| +                    # If gene search fails, put in singleton cluster\\n114| +                    cluster_id = f\\"singleton_{idx}\\"\\n115| +                    candidate_to_cluster[idx] = cluster_id\\n116| +                    clusters[cluster_id] = [idx]\\n117| +        \\n118| +        # Assign unassigned candidates to singleton clusters\\n119| +        for idx in all_indices:\\n120| +            if idx not in candidate_to_cluster:\\n121| +                cluster_id = f\\"singleton_{idx}\\"\\n122| +                candidate_to_cluster[idx] = cluster_id\\n123| +                clusters[cluster_id] = [idx]\\n124| +                \\n125| +    except ImportError:\\n126| +        # No gene search available - use enhanced fallback: gene family prefix clustering\\n127| +        # Group genes by name prefix to capture gene families (e.g., ZNF, ZSCAN, TNF, etc.)\\n128| +        gene_to_prefix = {}\\n129| +        \\n130| +        for idx in all_indices:\\n131| +            candidate = candidates[idx]\\n132| +            gene = candidate.get(\'gene\') or candidate.get(\'gene_a\')\\n133| +            if gene:\\n134| +                # Extract prefix: typically first 3-4 letters before numbers\\n135| +                # This captures gene families like ZNF, ZSCAN, TNF, IL, etc.\\n136| +                prefix = \'\'.join([c for c in gene if not c.isd