ize\\n 67| +    # More exploration in early rounds, more exploitation later\\n 68| +    num_rounds = len(history) // batch_size if batch_size > 0 else 0\\n 69| +    exploration_ratio = max(0.3, 0.8 - 0.15 * num_rounds)  # Starts at 80%, decreases to 30%\\n 70| +    \\n 71| +    # Separate exploration and exploitation\\n 72| +    num_explore = int(batch_size * exploration_ratio)\\n 73| +    num_exploit = batch_size - num_explore\\n 74| +    \\n 75| +    # Exploration: random sampling\\n 76| +    explore_indices = rng.sample(available, min(num_explore, len(available)))\\n 77| +    \\n 78| +    # Exploitation: select based on scores\\n 79| +    if len(history) > 0 and num_exploit > 0:\\n 80| +        # Sort history by score (descending)\\n 81| +        sorted_history = sorted(history, key=lambda x: x[\'score\'], reverse=True)\\n 82| +        \\n 83| +        # Get top performers\\n 84| +        top_performers = [h[\'candidate_index\'] for h in sorted_history[:min(50, len(sorted_history))]]\\n 85| +        \\n 86| +        # Find candidates similar to top performers (if gene search available)\\n 87| +        exploit_candidates = set()\\n 88| +        remaining_avail = [i for i in available if i not in explore_indices]\\n 89| +        \\n 90| +        if len(remaining_avail) > 0:\\n 91| +            # If we have top performers and gene search might be available, use it\\n 92| +            # Otherwise, sample from remaining with slight bias toward higher indices\\n 93| +            # (assuming some clustering in the candidate list)\\n 94| +            \\n 95| +            # Simple strategy: weighted sampling based on position (crude diversity)\\n 96| +            weights = np.abs(np.linspace(-1, 1, len(remaining_avail))) + 0.1\\n 97| +            weights = weights / weights.sum()\\n 98| +            \\n 99| +            try:\\n100| +                exploit_indices = rng.choices(\\n101| +                    remaining_avail, \\n102| +                    k=min(num_exploit, l