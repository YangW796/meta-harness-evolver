 sampling\\n 35| +    - Early rounds: More random exploration to discover promising regions\\n 36| +    - Later rounds: More exploitation of high-scoring candidates\\n 37| +    - Always maintain diversity to avoid getting stuck in local optima\\n 38|      \\"\\"\\"\\n 39| -    pass\\n 40| +    rng = random.Random(seed)\\n 41| +    \\n 42| +    # Get already selected indices\\n 43| +    selected = set(h[\'candidate_index\'] for h in history)\\n 44| +    \\n 45| +    # Get all available candidate indices\\n 46| +    all_indices = list(range(len(candidates)))\\n 47| +    available = [i for i in all_indices if i not in selected]\\n 48| +    \\n 49| +    if len(available) <= batch_size:\\n 50| +        return available\\n 51| +    \\n 52| +    # Calculate exploration ratio based on history size\\n 53| +    # More exploration in early rounds, more exploitation later\\n 54| +    num_rounds = len(history) // batch_size if batch_size > 0 else 0\\n 55| +    exploration_ratio = max(0.2, 0.9 - 0.15 * num_rounds)  # Starts at 90%, decreases to 20%\\n 56| +    \\n 57| +    # Separate exploration and exploitation\\n 58| +    num_explore = int(batch_size * exploration_ratio)\\n 59| +    num_exploit = batch_size - num_explore\\n 60| +    \\n 61| +    # Exploration: random sampling from available candidates\\n 62| +    explore_indices = rng.sample(available, min(num_explore, len(available)))\\n 63| +    \\n 64| +    # Exploitation: select based on historical scores\\n 65| +    if len(history) > 0 and num_exploit > 0:\\n 66| +        # Sort history by score (descending)\\n 67| +        sorted_history = sorted(history, key=lambda x: x[\'score\'], reverse=True)\\n 68| +        \\n 69| +        # Get top performers (top 20% or at least 10)\\n 70| +        top_k = max(10, len(sorted_history) // 5)\\n 71| +        top_performers = [h[\'candidate_index\'] for h in sorted_history[:top_k]]\\n 72| +        \\n 73| +        # Find candidates similar to top performers if gene search is available\\n 74| +        exploit_candidates = set()\\n 75| +        remaining_avail = [i for i in available if i not in explore_indices]\\n 76| +        \\n 77| +        if len(remaining_avail) > 0:\\n 78| +            # Try to use gene search if available\\n 79| +            try:\\n 80| +                import bda_tools\\n 81| +                # Sample from top performers and find similar genes\\n 82| +                num_to_sample = min(5, len(top_performers))\\n 83| +                sampled_top = rng.sample(top_performers, num_to_sample)\\n 84| +                \\n 85| +                for top_idx in sampled_top:\\n 86| +                    if len(exploit_candidates) >= num_exploit:\\n 87| +                        break\\n 88| +                    # Get gene name from candidate\\n 89| +                    candidate = candidates[top_idx]\\n 90| +                    gene = candidate.get(\'gene\') or candidate.get(\'gene_a\')\\n 91| +                    if gene:\\n 92| +                        try:\\n 93| +                            similar = bda_tools.gene_search(gene, k=min(20, num_exploit), diverse=False)\\n 94| +                            for idx in similar:\\n 95| +                                if idx in remaining_avail and idx not in exploit_candidates:\\n 96| +                                    exploit_candidates.add(idx)\\n 97| +                                    if len(exploit_candidates) >= num_exploit:\\n 98| +                                        break\\n 99| +                        except:\\n100| +                            pass\\n101| +            except ImportError:\\n102| +                # bda_tools not available, fall back to other strategies\\n103| +                pass\\n104| +            \\n105| +            # If we still need more candidates, use weighted sampling\\n106| +            if len(exploit_candidates) < num_exploit:\\n107| +                needed = num_exploit - len(exploit_candidates)\\n108| +                # Use stratified sampling for diversity: divide remaining into buckets\\n109| +                num_buckets = min(10, len(remaining_avail))\\n110| +                bucket_size = len(remaining_avail) // num_buckets\\n111| +                \\n112| +                sampled = set()\\n113| +                for bucket in range(num_buckets):\\n114| +                    if len(sampled) >= needed:\\n115| +                        break\\n116| +                    start = bucket * bucket_size\\n117| +                    end = start + bucket_size if bucket < num_buckets - 1 else len(remaining_avail)\\n118| +                    bucket_items = remaining_avail[start:end]\\n119| +                    if bucket_items:\\n120| +                        sampled.add(rng.choice(bucket_items))\\n121| +                \\n122| +                exploit_candidates.update(sampled)\\n123| +        \\n124| +        selected_indices = list(explore_indices) + list(exploit_candidates)[:num_exploit]\\n125| +    else:\\n126| +        # Pure exploration if no history or no exploitation needed\\n127| +        selected_indices = explore_indices\\n128| +    \\n129| +    # Ensure we have exactly batch_size indices\\n130| +    if len(selected_indices) < batch_size:\\n131| +        remaining = [i for i in available if i not in selected_indices]\\n132| +        needed = batch_size - len(selected_indices)\\n133| +        if remaining:\\n134| +            selected_indices.extend(rng.sample(remaining, min(needed, len(remaining))))\\n135| +    \\n136| +    return selected_indices[:batch_size]\\n137| \\n138| ```\\n139| \\n140| ### outputs/metrics.json\\n141| \\n142| ```diff\\n143| --- best/outputs/metrics.json\\n144| +++ candidate/outputs/metrics.json\\n145| @@ -0,0 +1,2233 @@\\n146| +{\\n147| +  \\"task\\": \\"perturb-genes-brief\\",\\n148| +  \\"data_name\\": \\"Sanchez21\\",\\n149| +  \\"measurement\\": \\"the change in tau protein level compared to the non-targeting control, using a total tau antibody\\",\\n150| +  \\"task_prompt\\": {