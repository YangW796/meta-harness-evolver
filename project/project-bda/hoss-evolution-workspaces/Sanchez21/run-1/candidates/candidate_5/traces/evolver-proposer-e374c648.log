m_rounds)  # Starts at 90%, decreases to 20%\\n 51|     \\n 52|     # Separate exploration and exploitation\\n 53|     num_explore = int(batch_size * exploration_ratio)\\n 54|     num_exploit = batch_size - num_explore\\n 55|     \\n 56|     # Exploration: random sampling from available candidates\\n 57|     explore_indices = rng.sample(available, min(num_explore, len(available)))\\n 58|     \\n 59|     # Exploitation: select based on historical scores\\n 60|     if len(history) > 0 and num_exploit > 0:\\n 61|         # Sort by absolute score to prioritize both negative and positive extremes\\n 62|         sorted_history = sorted(history, key=lambda x: abs(x[\'score\']), reverse=True)\\n 63|         \\n 64|         # Get top performers (highest absolute scores, 20% or at least 10)\\n 65|         top_k = max(10, len(sorted_history) // 5)\\n 66|         top_performers = [h[\'candidate_index\'] for h in sorted_history[:top_k]]\\n 67|         \\n 68|         # Find candidates similar to top performers if gene search is available\\n 69|         exploit_candidates = set()\\n 70|         remaining_avail = [i for i in available if i not in explore_indices]\\n 71|         \\n 72|         if len(remaining_avail) > 0:\\n 73|             # Try to use gene search if available\\n 74|             try:\\n 75|                 import bda_tools\\n 76|                 \\n 77|                 # If hit information is available, prioritize actual hits over just high absolute scores\\n 78|                 if any(\'hit\' in h for h in history):\\n 79|                     hit_indices = [h[\'candidate_index\'] for h in history if h.get(\'hit\') == 1]\\n 80|                     if hit_indices:\\n 81|                         # Prioritize genes that are actual hits\\n 82|                         top_performers = hit_indices[:min(len(hit_indices), top_k)]\\n 83|                 \\n 84|                 # Sample more aggressively from top performers\\n 85|                 num_to_sample = min(10, le