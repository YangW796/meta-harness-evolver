g for diversity: divide remaining into buckets\\n109| +                num_buckets = min(10, len(remaining_avail))\\n110| +                bucket_size = len(remaining_avail) // num_buckets\\n111| +                \\n112| +                sampled = set()\\n113| +                for bucket in range(num_buckets):\\n114| +                    if len(sampled) >= needed:\\n115| +                        break\\n116| +                    start = bucket * bucket_size\\n117| +                    end = start + bucket_size if bucket < num_buckets - 1 else len(remaining_avail)\\n118| +                    bucket_items = remaining_avail[start:end]\\n119| +                    if bucket_items:\\n120| +                        sampled.add(rng.choice(bucket_items))\\n121| +                \\n122| +                exploit_candidates.update(sampled)\\n123| +        \\n124| +        selected_indices = list(explore_indices) + list(exploit_candidates)[:num_exploit]\\n125| +    else:\\n126| +        # Pure exploration if no history or no exploitation needed\\n127| +        selected_indices = explore_indices\\n128| +    \\n129| +    # Ensure we have exactly batch_size indices\\n130| +    if len(selected_indices) < batch_size:\\n131| +        remaining = [i for i in available if i not in selected_indices]\\n132| +        needed = batch_size - len(selected_indices)\\n133| +        if remaining:\\n134| +            selected_indices.extend(rng.sample(remaining, min(needed, len(remaining))))\\n135| +    \\n136| +    return selected_indices[:batch_size]\\n137| \\n138| ```\\n139| \\n140| ### outputs/metrics.json\\n141| \\n142| ```diff\\n143| --- best/outputs/metrics.json\\n144| +++ candidate/outputs/metrics.json\\n145| @@ -0,0 +1,2233 @@\\n146| +{\\n147| +  \\"task\\": \\"perturb-genes-brief\\",\\n148| +  \\"data_name\\": \\"Sanchez21\\",\\n149| +  \\"measurement\\": \\"the change in tau protein level compared to the non-targeting control, using a total tau antibody\\",\\n150| +  \\"task_prompt\\": {