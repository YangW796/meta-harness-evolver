n102| \\n103| \\n104| def _encode_sequences(\\n105|     sequences: list[str],\\n106|     esm_model,\\n107|     batch_converter,\\n108|     device: str,\\n109|     batch_size: int,\\n110| ) -> np.ndarray:\\n111|     out_chunks: list[np.ndarray] = []\\n112|     for start in tqdm(range(0, len(sequences), batch_size), desc=\\"Encoding\\", unit=\\"batch\\"):\\n113|         batch = [(str(i), sequences[i]) for i in range(start, min(len(sequences), start + batch_size))]\\n114|         _, _, tokens = batch_converter(batch)\\n115|         tokens = tokens.to(device)\\n116|         with torch.no_grad():\\n117|             out = esm_model(tokens, repr_layers=[6])\\n118|         emb = out[\\"representations\\"][6].mean(1).detach().cpu().numpy().astype(np.float32, copy=False)\\n119|         out_chunks.append(emb)\\n120|     if not out_chunks:\\n121|         return np.zeros((0, 320), dtype=np.float32)\\n122|     return np.concatenate(out_chunks, axis=0)\\n123| \\n124| \\n125| def _load_with_split(csv_path: str, split_file: str) -> pd.DataFrame:\\n126|     df = pd.read_csv(csv_path)\\n127|     required_columns = {\\"Sequence\\", \\"Structure\\", \\"iptm\\", \\"DDG\\", \\"SAP Score\\", \\"FV Charge\\"}\\n128|     missing = sorted(required_columns - set(df.columns))\\n129|     if missing:\\n130|         raise ValueError(f\\"Missing required columns: {missing}\\")\\n131| \\n132|     split_path = Path(split_file).expanduser()\\n133|     if not split_path.is_absolute():\\n134|         split_path = Path(csv_path).expanduser().resolve().parent / split_path\\n135|     if not split_path.exists():\\n136|         raise ValueError(f\\"Missing split_file: {split_path}\\")\\n137| \\n138|     split_df = pd.read_csv(split_path)\\n139|     if \\"split\\" not in split_df.columns:\\n140|         raise ValueError(f\\"split_file missing \'split\' column: {split_path}\\")\\n141| \\n142|     if required_columns.issubset(set(split_df.columns)):\\n143|         merged = split_df\\n144|     else:\\n145|      