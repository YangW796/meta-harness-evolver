reate 4 attention heads, each focusing on different segments of the 320-dim sequence\\n 26|         np.random.seed(seed)\\n 27|         self.num_heads = 4\\n 28|         self.head_dim = 320 // self.num_heads  # 80 dimensions per head\\n 29|         \\n 30|         self.model = RandomForestRegressor(\\n 31|             n_estimators=300,\\n 32|             max_depth=20,\\n 33|             min_samples_split=10,\\n 34|             min_samples_leaf=4,\\n 35|             max_features=\'sqrt\',\\n 36|             random_state=seed,\\n 37|             n_jobs=-1\\n 38|         )\\n 39|         self.is_fitted = False\\n 40|     \\n 41|     def _create_interaction_features(self, X: np.ndarray) -> np.ndarray:\\n 42|         \\"\\"\\"\\n 43|         Create selective attention-weighted interaction features between sequence and structure.\\n 44|         \\n 45|         Uses structure features to compute multiple diverse attention patterns over different\\n 46|         segments of sequence embeddings, enabling fine-grained modulation of sequence importance.\\n 47|         \\n 48|         Args:\\n 49|             X: Input features of shape (N, 322)\\n 50|             \\n 51|         Returns:\\n 52|             Enhanced features with selective attention-weighted interactions\\n 53|         \\"\\"\\"\\n 54|         # Separate modalities\\n 55|         X_seq = X[:, :320]  # Sequence embeddings\\n 56|         X_struct = X[:, 320:]  # Structure features (atom_count/10000, residue_count/1000)\\n 57|         \\n 58|         # Normalize sequence embeddings\\n 59|         seq_mean = X_seq.mean(axis=1, keepdims=True)\\n 60|         seq_std = X_seq.std(axis=1, keepdims=True) + 1e-8\\n 61|         X_seq_norm = (X_seq - seq_mean) / seq_std\\n 62|         \\n 63|         # Create selective attention-weighted interactions\\n 64|         interactions = []\\n 65|         for struct_idx in range(X_struct.shape[1]):\\n 66|             struct_feat = X_struct[:, struct_idx:struct_idx+1]  # (N, 1)\\n 67|             \\n 68|             # Create multiple attention heads, each focusing on different sequence segments\\n 69|             for head_idx in range(self.num_heads):\\n 70|                 # Select segment of sequence embedding for this head\\n 71|                 start_dim = head_idx * self.head_dim\\n 72|                 end_dim = start_dim + self.head_dim\\n 73|                 seq_segment = X_seq_norm[:, start_dim:end_dim]  # (N, 80)\\n 74|                 \\n 75|                 # Compute head-specific attention weight with offset for diversity\\n 76|                 head_offset = head_idx * 0.5  # Different offset per head\\n 77|                 attention_key = struct_feat + head_offset\\n 78|                 attention_weights = 1 / (1 + np.exp(-attention_key))  # (N, 1)\\n 79|                 \\n 80|                 # Apply attention to this sequence segment\\n 81|                 attended_segment = attention_weights * seq_segment  # (N, 80)\\n 82|                 interactions.append(attended_segment)\\n 83|                 \\n 84|                 # Include complementary attention for this segment\\n 85|                 comp_attention = 1 - attention_weights\\n 86|                 comp_attended_segment = comp_attention * seq_segment\\n 87|                 interactions.append(comp_attended_segment)\\n 88|             \\n 89|             # Also include global attention (original behavior) for full sequence\\n 90|             global_attention = 1 / (1 + np.exp(-struct_feat))\\n 91|             global_attended = global_attention * X_seq_norm\\n 92|             interactions.append(global_attended)\\n 93|             \\n 94|             # Include squared structure feature interactions\\n 95|             struct_sq = struct_feat ** 2\\n 96|             sq_attention = 1 / (1 + np.exp(-struct_sq))\\n 97|             sq_attended_seq = sq_attention * X_seq_norm\\n 98|             interactions.append(sq_attended_seq)\\n 99|         \\n100|         # Concatenate all features: original + selective attention-weighted interactions\\n101|         X_enhanced = np.hstack([X, *interactions])\\n102|         \\n103|         return X_enhanced\\n104|     \\n105|     def fit(self, X: np.ndarray, y: np.ndarray):\\n106|         \\"\\"\\"\\n107|         Train the model with feature scaling and interaction features.\\n108|         \\"\\"\\"\\n109|         # Create interaction features\\n110|         X_enhanced = self._create_interaction_features(X)\\n111|         \\n112|         # Scale all features\\n113|         X_scaled = self.scaler.fit_transform(X_enhanced)\\n114|         \\n115|         # Train RandomForest\\n116|         self.model.fit(X_scaled, y)\\n117|         self.is_fitted = True\\n118|     \\n119|     def predict(self, X: np.ndarray) -> np.ndarray:\\n120|         \\"\\"\\"\\n121|         Predict output values.\\n122|         \\n123|         Returns shape (N,)\\n124|         \\"\\"\\"\\n125|         if not self.is_fitted:\\n126|             # Return mean prediction if not fitted\\n127|             return np.full(len(X), 0.0)\\n128|         \\n129|         # Create interaction features (same as in fit)\\n130|         X_enhanced = self._create_interaction_features(X)\\n131|         \\n132|         # Scale features and predict\\n133|         X_scaled = self.scaler.transform(X_enhanced)\\n134|         pred = self.model.predict(X_scaled)\\n135|         return pred.reshape(-1)\\n136| \\n137| \\n138| def train_model(\\n139|     X_train: np.ndarray,\\n140|     y_train: np.ndarray,\\n141|     input_dim: int,\\n142|     device: str,\\n143|     seed: int,\\n144| ) -> object:\\n145|     \\"\\"\\"\\n146|     Train and return a model.\\n147|     \\"\\"\\"\\n148|     \\n149|     np.random.seed(int(seed))\\n150|     \\n151|     model = MLModel(input_dim=input_dim, seed=int(seed))\\n152|     \\n153|     # Train the model\\n154|     model.fit(X_train, y_train)\\n155|     \\n156|     return model\\n157| \\n158| \\n159| def predict_model(model: object, X: np.ndarray, device: str) -> np.ndarray:\\n160|     \\"\\"\\"\\n161|     Run prediction.\\n162|     \\"\\"\\"\\n163|     \\n164|     if not hasattr(model, \\"predict\\"):\\n165|         raise TypeError(\\"model must implement a predict() method\\")\\n166|     \\n167|     pred = model.predict(X)\\n168|     return np.asarray(pred)\\n169| \\n170| \\n171| def save_model(model: object, path: str) -> None:\\n172|     \\"\\"\\"\\n173|     Save the model using pickle.\\n174|     \\"\\"\\"\\n175|     \\n176|     import pickle\\n177|     \\n178|     with open(path, \\"wb\\") as f:\\n179|         pickle.dump(model, f)\\n180| \\n181| \\n182| def load_model(path: str, input_dim: int, device: str) -> object:\\n183|     \\"\\"\\"\\n184|     Load the model.\\n185|     \\"\\"\\"\\n186|     \\n187|     import pickle\\n188|     \\n189|     with open(path, \\"rb\\") as f:\\n190|         model = pickle.load(f)\\n191|     \\n192|     return model"\n}'}, {'role': 'tool', 'tool_call_id': 'tooluse_ue2zhDcxt60BQRJa7Wa31j', 'content': '{\n  "content": "  1| from __future__ import annotations\\n  2| \\n  3| import numpy as np\\n  4| import torch\\n  5| import torch.nn as nn\\n  6| import torch.optim as optim\\n  7| from sklearn.preprocessing import StandardScaler\\n  8| \\n  9| \\n 10| class NeuralNetworkModel:\\n 11|     \\"\\"\\"\\n 12|     A neural network with pairwise ranking loss for predicting composite scores from \\n 13|     sequence embeddings (320 dims) and structure features (2 dims).\\n 14|     Uses RankNet-style pairwise ranking to optimize for ranking quality.\\n 15|     \\"\\"\\"\\n 16|     \\n 17|     def __init__(self, input_dim: int, device: str = \\"cpu\\", seed: int = 42):\\n 18|         self.input_dim = input_dim\\n 19|         self.device = device\\n 20|         self.seed = seed\\n 21|         \\n 22|         # Set random seeds for reproducibility\\n 23|         torch.manual_seed(seed)\\n 24|         np.random.seed(seed)\\n 25|         \\n 26|         # Initialize feature normalizer\\n 27|         self.scaler = StandardScaler()\\n 28|         \\n 29|         # Define a simple MLP architecture\\n 30|         self.network = nn.Sequential(\\n 31|             nn.Linear(input_dim, 256),\\n 32|             nn.ReLU(),\\n 33|             nn.Dropout(0.2),\\n 34|             nn.Linear(256, 128),\\n 35|             nn.ReLU(),\\n 36|             nn.Dropout(0.2),\\n 37|             nn.Linear(128, 64),\\n 38|             nn.ReLU(),\\n 39|             nn.Linear(64, 1)\\n 40|         ).to(device)\\n 41|         \\n 42|         # Use pairwise ranking loss (like RankNet) instead of MSE\\n 43|         # This optimizes for ranking order rather than exact values\\n 44|         self.criterion = nn.BCEWithLogitsLoss()\\n 45|         self.optimizer = optim.Adam(self.network.parameters(), lr=0.001, weight_decay=0.0001)\\n 46|         self.scheduler = optim.lr_scheduler.StepLR(self.optimizer, step_size=15, gamma=0.5)\\n 47|         \\n 48|     def fit(self, X: np.ndarray, y: np.ndarray, epochs: int = 50, batch_size: int = 32):\\n 49|         \\"\\"\\"\\n 50|         Train the neural network using pairwise ranking loss.\\n 51|         \\"\\"\\"\\n 52|         # Normalize input features\\n 53|         X_normalized = self.scaler.fit_transform(X)\\n 54|         \\n 55|         X_tensor = torch.FloatTensor(X_normalized).to(self.device)\\n 56|         y_tensor = torch.FloatTensor(y).to(self.device)\\n 57|         \\n 58|         self.network.train()\\n 59|         for epoch in range(epochs):\\n 60|             epoch_loss = 0.0\\n 61|             num_batches = 0\\n 62|             \\n 63|             # Generate random pairs for pairwise training\\n 64|             indices = torch.randperm(len(X_tensor))\\n 65|             for i in range(0, len(indices) - 1, 2):\\n 66|                 if i + 1 >= len(indices):\\n 67|                     break\\n 68|                     \\n 69|                 idx1, idx2 = indices[i], indices[i + 1]\\n 70|                 \\n 71|                 # Get the pair of samples\\n 72|                 x1 = X_tensor[idx1].unsqueeze(0)\\n 73|                 x2 = X_tensor[idx2].unsqueeze(0)\\n 74|                 y1 = y_tensor[idx1]\\n 75|                 y2 = y_tensor[idx2]\\n 76|                 \\n 77|                 # Determine which sample has higher score (label = 1 if y1 > y2, else 0)\\n 78|                 label = 1.0 if y1 > y2 else 0.0\\n 79|                 label_tensor = torch.tensor([[label]], dtype=torch.float32, device=self.device)\\n 80|                 \\n 81|                 # Forward pass for both samples\\n 82|                 self.optimizer.zero_grad()\\n 83|                 pred1 = self.network(x1)\\n 84|                 pred2 = self.network(x2)\\n 85|                 \\n 86|                 # Compute the difference in predictions (logit for pairwise comparison)\\n 87|                 pred_diff = pred1 - pred2\\n 88|                 \\n 89|                 # Binary cross-entropy loss on the difference\\n 90|                 loss = self.criterion(pred_diff, label_tensor)\\n 91|                 loss.backward()\\n 92|                 \\n 93|                 # Clip gradients to prevent exploding gradients\\n 94|                 torch.nn.utils.clip_grad_norm_(self.network.parameters(), max_norm=1.0)\\n 95|                 \\n 96|                 self.optimizer.step()\\n 97|                 epoch_loss += loss.item()\\n 98|                 num_batches += 1\\n 99|             \\n100|             # Print progress every 10 epochs\\n101|             if (epoch + 1) % 10 == 0 and num_batches > 0:\\n102|                 avg_loss = epoch_loss / num_batches\\n103|                 current_lr = self.optimizer.param_groups[0][\'lr\']\\n104|                 print(f\\"Epoch {epoch + 1}/{epochs}, Avg Loss: {avg_loss:.4f}, LR: {current_lr:.6f}\\")\\n105|             \\n106|             # Step the learning rate scheduler\\n107|             self.scheduler.step()\\n108|     \\n109|     def predict(self, X: np.ndarray) -> np.ndarray:\\n110|         \\"\\"\\"\\n111|         Predict output values.\\n112|         \\"\\"\\"\\n113|         self.network.eval()\\n114|         with torch.no_grad():\\n115|             # Normalize input features using fitted scaler\\n116|             X_normalized = self.scaler.transform(X)\\n117|             X_tensor = torch.FloatTensor(X_normalized).to(self.device)\\n118|             predictions = self.network(X_tensor)\\n119|             return predictions.cpu().numpy().flatten()\\n120| \\n121| \\n122| def train_model(\\n123|     X_train: np.ndarray,\\n124|     y_train: np.ndarray,\\n125|     input_dim: int,\\n126|     device: str,\\n127|     seed: int,\\n128| ) -> object:\\n129|     \\"\\"\\"\\n130|     Train and return a neural network model.\\n131|     \\"\\"\\"\\n132|     \\n133|     np.random.seed(int(seed))\\n134|     torch.manual_seed(int(seed))\\n135|     \\n136|     model = NeuralNetworkModel(input_dim=input_dim, device=device, seed=seed)\\n137|     \\n138|     # Train the model\\n139|     model.fit(X_train, y_train, epochs=100, batch_size=32)\\n140|     \\n141|     return model\\n142| \\n143| \\n144| def predict_model(model: object, X: np.ndarray, device: str) -> np.ndarray:\\n145|     \\"\\"\\"\\n146|     Run prediction.\\n147|     \\"\\"\\"\\n148|     \\n149|     if not hasattr(model, \\"predict\\"):\\n150|         raise TypeError(\\"model must implement a predict() method\\")\\n151|     \\n152|     pred = model.predict(X)\\n153|     return np.asarray(pred)\\n154| \\n155| \\n156| def save_model(model: object, path: str) -> None:\\n157|     \\"\\"\\"\\n158|     Save the model using torch.save.\\n159|     \\"\\"\\"\\n160|     \\n161|     if not hasattr(model, \\"network\\"):\\n162|         raise ValueError(\\"Model must have a \'network\' attribute to save\\")\\n163|     \\n164|     torch.save({\\n165|         \'model_state_dict\': model.network.state_dict(),\\n166|         \'optimizer_state_dict\': model.optimizer.state_dict(),\\n167|         \'scheduler_state_dict\': model.scheduler.state_dict(),\\n168|         \'scaler_state\': {\\n169|             \'mean_\': model.scaler.mean_,\\n170|             \'scale_\': model.scaler.scale_,\\n171|             \'var_\': model.scaler.var_,\\n172|             \'n_features_in_\': model.scaler.n_features_in_,\\n173|             \'n_samples_seen_\': model.scaler.n_samples_seen_\\n174|         },\\n175|         \'input_dim\': model.input_dim,\\n176|         \'device\': model.device,\\n177|         \'seed\': model.seed\\n178|     }, path)\\n179| \\n180| \\n181| def load_model(path: str, input_dim: int, device: str) -> object:\\n182|     \\"\\"\\"\\n183|     Load the model.\\n184|     \\"\\"\\"\\n185|     \\n186|     checkpoint = torch.load(path, map_location=device)\\n187|     \\n188|     model = NeuralNetworkModel(\\n189|         input_dim=checkpoint[\'input_dim\'],\\n190|         device=checkpoint[\'device\'],\\n191|         seed=checkpoint[\'seed\']\\n192|     )\\n193|     \\n194|     model.network.load_state_dict(checkpoint[\'model_state_dict\'])\\n195|     model.optimizer.load_state_dict(checkpoint[\'optimizer_state_dict\'])\\n196|     model.scheduler.load_state_dict(checkpoint[\'scheduler_state_dict\'])\\n197|     \\n198|     # Restore scaler state\\n199|     if \'scaler_state\' in checkpoint:\\n200|         model.scaler.mean_ = checkpoint[\'scaler_state\'][\'mean_\']\\n201|         model.scaler.scale_ = checkpoint[\'scaler_state\'][\'scale_\']\\n202|         model.scaler.var_ = checkpoint[\'scaler_state\'][\'var_\']\\n203|         model.scaler.n_features_in_ = checkpoint[\'scaler_state\'][\'n_features_in_\']\\n204|         model.scaler.n_samples_seen_ = checkpoint[\'scaler_state\'][\'n_samples_seen_\']\\n205|     \\n206|     return model"\n}'}, {'role': 'tool', 'tool_call_id': 'tooluse_D8qORAopCfqnGnpat8cZbH', 'content': '{\n  "content": "\\n\\nIMPORTANT: The file content has been truncated.\\nNote: 29 trailing lines (~27709 chars) were truncated to