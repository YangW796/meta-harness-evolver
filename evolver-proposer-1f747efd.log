\\", \\"candidate\\": \\"candidate_20\\", \\"candidate_dir\\": \\"/inspire/qb-ilm/project/cq-scientific-cooperation-zone/public/ywang/meta-harness-evolver/project/project-2-simple-split-model/hoss-evolution-2/candidates/candidate_20\\", \\"proposer_success\\": true, \\"scores\\": {\\"final_score\\": 33.8, \\"category_scores\\": {\\"topk_f1\\": 33.8}, \\"scenario_scores\\": {\\"test_f1\\": 0.338, \\"top_ratio\\": 0.2, \\"top_k\\": 500, \\"num_samples\\": 2500}, \\"total_scenarios\\": 1, \\"evaluated_at\\": \\"2026-04-19T03:10:35.981330\\"}, \\"final_score\\": 33.8, \\"changes\\": {\\"candidate\\": \\"candidate_20\\", \\"compared_against\\": \\"/inspire/qb-ilm/project/cq-scientific-cooperation-zone/public/ywang/meta-harness-evolver/project/project-2-simple-split-model/hoss-evolution-2/best/current/harness\\", \\"generated_at\\": \\"2026-04-19T03:10:35.991061\\", \\"changed_files_count\\": 1, \\"changed_files\\": [{\\"file\\": \\"model.py\\", \\"status\\": \\"modified\\", \\"added_lines\\": 48, \\"deleted_lines\\": 12, \\"line_delta\\": 36}]}}\\n17| {\\"timestamp\\": \\"2026-04-19T03:12:16.278259\\", \\"candidate\\": \\"candidate_21\\", \\"candidate_dir\\": \\"/inspire/qb-ilm/project/cq-scientific-cooperation-zone/public/ywang/meta-harness-evolver/project/project-2-simple-split-model/hoss-evolution-2/candidates/candidate_21\\", \\"proposer_success\\": true, \\"scores\\": {\\"final_score\\": 36.6, \\"category_scores\\": {\\"topk_f1\\": 36.6}, \\"scenario_scores\\": {\\"test_f1\\": 0.366, \\"top_ratio\\": 0.2, \\"top_k\\": 500, \\"num_samples\\": 2500}, \\"total_scenarios\\": 1, \\"evaluated_at\\": \\"2026-04-19T03:12:16.259634\\"}, \\"final_score\\": 36.6, \\"changes\\": {\\"candidate\\": \\"candidate_21\\", \\"compared_against\\": \\"/inspire/qb-ilm/project/cq-scientific-cooperation-zone/public/ywang/meta-harness-evolver/project/project-2-simple-split-model/hoss-evolution-2/best/current/harness\\", \\"generated_at\\": \\"2026-04-19T03:12:16.274275\\", \\"changed_files_