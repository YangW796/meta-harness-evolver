R] candidate_36\\n[DIR] candidate_37\\n[DIR] candidate_38\\n[DIR] candidate_39\\n[DIR] candidate_4\\n[DIR] candidate_40\\n[DIR] candidate_41\\n[DIR] candidate_42\\n[DIR] candidate_43\\n[DIR] candidate_44\\n[DIR] candidate_45\\n[DIR] candidate_46\\n[DIR] candidate_47\\n[DIR] candidate_48\\n[DIR] candidate_49\\n[DIR] candidate_5\\n[DIR] candidate_50\\n[DIR] candidate_6\\n[DIR] candidate_7\\n[DIR] candidate_8\\n[DIR] candidate_9"\n}'}, {'role': 'tool', 'tool_call_id': 'tooluse_aIW4LHHRm3PdVolb4dCjD2', 'content': '{\n  "content": "Directory listing for /inspire/qb-ilm/project/cq-scientific-cooperation-zone/public/ywang/meta-harness-evolver/project/project-2-simple-split-model/hoss-evolution-3/candidates:\\n[DIR] candidate_1\\n[DIR] candidate_10\\n[DIR] candidate_11\\n[DIR] candidate_12\\n[DIR] candidate_13\\n[DIR] candidate_14\\n[DIR] candidate_15\\n[DIR] candidate_2\\n[DIR] candidate_3\\n[DIR] candidate_4\\n[DIR] candidate_5\\n[DIR] candidate_6\\n[DIR] candidate_7\\n[DIR] candidate_8\\n[DIR] candidate_9"\n}'}, {'role': 'tool', 'tool_call_id': 'tooluse_KSyHMSZSMRz62SL8ryFpSo', 'content': '{\n  "content": "  1| import argparse\\n  2| import importlib.util\\n  3| import json\\n  4| import os\\n  5| import sys\\n  6| from pathlib import Path\\n  7| \\n  8| import esm\\n  9| import numpy as np\\n 10| import pandas as pd\\n 11| import torch\\n 12| from sklearn.metrics import f1_score\\n 13| \\n 14| try:\\n 15|     project_dir = Path(__file__).resolve().parents[4]\\n 16| except IndexError:\\n 17|     project_dir = None\\n 18| \\n 19| if project_dir is not None:\\n 20|     sys.path.insert(0, str(project_dir))\\n 21| else:\\n 22|     for p in Path(__file__).resolve().parents:\\n 23|         if (p / \\"index.py\\").exists():\\n 24|             sys.path.insert(0, str(p))\\n 25|             break\\n 26| \\n 27| from index import compute_x\\n 28| \\n 29| try:\\n 30|     from tqdm import tqdm  # type: ignore\\n 31| except ModuleNotFoundError:\\n 32|     def tqdm(it, **kwargs):\\n 33|         return it\\n 34| \\n 35| \\n 36| def _load_model_api(model_dir: str):\\n 37|     model_path = Path(model_dir).expanduser().resolve()\\n 38|     if not model_path.exists():\\n 39|         raise ValueError(f\\"model_dir does not exist: {model_path}\\")\\n 40| \\n 41|     spec = importlib.util.spec_from_file_location(\\"candidate_model_module\\", str(model_path))\\n 42|     if spec is None or spec.loader is None:\\n 43|         raise RuntimeError(f\\"Failed to load model module from: {model_path}\\")\\n 44|     module = importlib.util.module_from_spec(spec)\\n 45|     sys.modules[spec.name] = module\\n 46|     spec.loader.exec_module(module)\\n 47| \\n 48|     required = [\\"train_model\\", \\"predict_model\\", \\"save_model\\", \\"load_model\\"]\\n 49|     missing = [name for name in required if not hasattr(module, name)]\\n 50|     if missing:\\n 51|         raise ValueError(f\\"model file missing required functions: {missing}\\")\\n 52|     return module\\n 53| \\n 54| \\n 55| def parse_cif(cif_path: str) -> list[float]:\\n 56|     atom_count = 0\\n 57|     residue_set = set()\\n 58| \\n 59|     if not os.path.exists(cif_path):\\n 60|         return [0.0, 0.0]\\n 61| \\n 62|     with open(cif_path, encoding=\\"utf-8\\", errors=\\"ignore\\") as f:\\n 63|         for line in f:\\n 64|             if line.startswith(\\"ATOM\\"):\\n 65|                 atom_count += 1\\n 66|                 parts = line.split()\\n 67|                 if len(parts) > 5:\\n 68|                     residue_set.add(parts[5])\\n 69|     return [atom_count / 10000.0, len(residue_set) / 1000.0]\\n 70| \\n 71| \\n 72| def get_cif_path(structure: str, root_dir: str) -> str:\\n 73|     pdb_id = structure.split(\\"_\\")[0]\\n 74|     return os.path.join(root_dir, pdb_id, \\"af3_output\\", structure, f\\"{structure}_model.cif\\")\\n 75| \\n 76| \\n 77| def _resolve_device(device: str) -> str:\\n 78|     d = (device or \\"auto\\").strip().lower()\\n 79|     if d == \\"auto\\":\\n 80|         return \\"cuda\\" if torch.cuda.is_available() else \\"cpu\\"\\n 81|     if d.startswith(\\"cuda\\") and not torch.cuda.is_available():\\n 82|         return \\"cpu\\"\\n 83|     return d\\n 84| \\n 85| \\n 86| def load_esm(device: str):\\n 87|     print(\\"Loading ESM...\\")\\n 88|     model, alphabet = esm.pretrained.esm2_t6_8M_UR50D()\\n 89|     batch_converter = alphabet.get_batch_converter()\\n 90|     model.eval()\\n 91|     model = model.to(device)\\n 92|     return model, batch_converter\\n 93| \\n 94| \\n 95| def _make_topk_labels(values: np.ndarray, top_ratio: float) -> np.ndarray:\\n 96|     n = len(values)\\n 97|     k = max(1, int(n * top_ratio))\\n 98|     idx = np.argsort(-values)\\n 99|     labels = np.zeros(n, dtype=np.int64)\\n100|     labels[idx[:k]] = 1\\n101|     return labels\\n102| \\n103| \\n104| def _encode_sequences(\\n105|     sequences: list[str],\\n106|     esm_model,\\n107|     batch_converter,\\n108|     device: str,\\n109|     batch_size: int,\\n110| ) -> np.ndarray:\\n111|     out_chunks: list[np.ndarray] = []\\n112|     for start in tqdm(range(0, len(sequences), batch_size), desc=\\"Encoding\\", unit=\\"batch\\"):\\n113|         batch = [(str(i), sequences[i]) for i in range(start, min(len(sequences), start + batch_size))]\\n114|         _, _, tokens = batch_converter(batch)\\n115|         tokens = tokens.to(device)\\n116|         with torch.no_grad():\\n117|             out = esm_model(tokens, repr_layers=[6])\\n118|         emb = out[\\"representations\\"][6].mean(1).detach().cpu().numpy().astype(np.float32, copy=False)\\n119|         out_chunks.append(emb)\\n120|     if not out_chunks:\\n121|         return np.zeros((0, 320), dtype=np.float32)\\n122|     return np.concatenate(out_chunks, axis=0)\\n123| \\n124| \\n125| def _load_with_split(csv_path: str, split_file: str) -> pd.DataFrame:\\n126|     df = pd.read_csv(csv_path)\\n127|     required_columns = {\\"Sequence\\", \\"Structure\\", \\"iptm\\", \\"DDG\\", \\"SAP Score\\", 